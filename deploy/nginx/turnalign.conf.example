# Install inside the nginx `http` context after replacing the hostname and
# certificate paths. Keep the TurnAlign listener on 127.0.0.1 only.

map $http_upgrade $turnalign_connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=turnalign_handshake:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=turnalign_connections:10m;

upstream turnalign_backend {
    server 127.0.0.1:8765;
    keepalive 8;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name asr.example.com;

    ssl_certificate /etc/letsencrypt/live/asr.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/asr.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;

    location = /healthz {
        access_log off;
        proxy_pass http://turnalign_backend/healthz;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /readyz {
        access_log off;
        proxy_pass http://turnalign_backend/readyz;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Metrics are intentionally available only on the loopback application
    # listener. Scrape 127.0.0.1:8765 from a host-local collector.
    location = /metrics {
        access_log off;
        return 404;
    }

    location = /ws {
        limit_req zone=turnalign_handshake burst=10 nodelay;
        limit_conn turnalign_connections 4;

        proxy_pass http://turnalign_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $turnalign_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_next_upstream off;
    }
}
